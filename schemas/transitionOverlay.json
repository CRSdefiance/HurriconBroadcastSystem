{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["requestId", "phase", "style", "durationMs", "startedAt"],
  "properties": {
    "requestId": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["idle", "covering", "revealing", "error"] },
    "style": { "enum": ["corner", "diagonal", "iris"] },
    "durationMs": { "type": "integer", "minimum": 400, "maximum": 4000 },
    "startedAt": { "type": "number", "minimum": 0 },
    "error": { "type": "string", "maxLength": 240 }
  },
  "additionalProperties": false
}
