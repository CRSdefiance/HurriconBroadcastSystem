{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["folders", "stations"],
  "properties": {
    "folders": { "type": "array", "items": { "type": "string", "maxLength": 120 } },
    "stations": { "type": "array", "items": { "type": "object", "required": ["id", "key", "name"], "properties": { "id": { "type": "integer" }, "key": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
    "error": { "type": "string", "maxLength": 500 }
  },
  "additionalProperties": false
}
