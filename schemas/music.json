{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["source", "rainwaveStation", "localFolder", "volume", "fadeMs", "playing", "status", "updatedAt"],
  "properties": {
    "source": { "enum": ["rainwave", "local"] },
    "rainwaveStation": { "type": "string", "maxLength": 40 },
    "localFolder": { "type": "string", "maxLength": 120 },
    "volume": { "type": "number", "minimum": 0, "maximum": 1 },
    "fadeMs": { "type": "number", "minimum": 0, "maximum": 10000 },
    "playing": { "type": "boolean" },
    "status": { "enum": ["stopped", "loading", "playing", "error"] },
    "streamUrl": { "type": "string", "maxLength": 1000 },
    "trackTitle": { "type": "string", "maxLength": 240 },
    "artist": { "type": "string", "maxLength": 240 },
    "album": { "type": "string", "maxLength": 240 },
    "artworkUrl": { "type": "string", "maxLength": 1000 },
    "trackKey": { "type": "string", "maxLength": 500 },
    "error": { "type": "string", "maxLength": 500 },
    "updatedAt": { "type": "number" }
  },
  "additionalProperties": false
}
